{
  "cli_default_open_behavior": "existing_window",
  "autosave": "on_focus_change",
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "git_panel": {
    "dock": "left"
  },
  "edit_predictions": {
    "provider": "copilot"
  },
  "agent_servers": {
    "claude-acp": {
      "type": "registry"
    },
    "codex-acp": {
      "type": "registry"
    },
    "github-copilot-cli": {
      "type": "registry"
    }
  },
  "terminal": {
    "font_size": 15.0,
    "font_family": "JetBrainsMono Nerd Font",
    "font_fallbacks": [
      "Noto Sans CJK SC",
      "Consolas"
    ],
    "cursor_shape": "bar",
    "blinking": "on"
  },
  "base_keymap": "VSCode",
  "minimap": {
    "show": "always"
  },
  "buffer_font_fallbacks": [
    "Noto Sans CJK SC"
  ],
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "icon_theme": {
    "mode": "system",
    "light": "Catppuccin Latte",
    "dark": "Catppuccin Frappé"
  },
  "ui_font_size": 16,
  "buffer_font_size": 17.0,
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "Catppuccin Mocha",
  },
}
